{
  "manifest_version": 3,
  "name": "Gemini Quota & Usage Bridge",
  "version": "1.0.0",
  "description": "Syncs Gemini 5-hour rolling usage and quota limits directly with your Windows Top Menu Bar in real time.",
  "permissions": [
    "storage",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "https://gemini.google.com/*",
    "http://127.0.0.1:38281/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_1",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://gemini.google.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Gemini Quota Bridge"
  }
}
